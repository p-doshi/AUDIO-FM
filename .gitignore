# venv (lives in $HOME as audio-comp-venv, not inside the repo, but ignore just in case)
.venv/
venv/
.env
audio-comp-venv/

# local Claude Code settings — settings.local.json has held a plaintext HF
# token before (via an auto-approved Bash permission rule); never commit it
.claude/settings.local.json

# python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# large/derived artifacts — probe_set_manifest.csv is the only tracked probe-set
# artifact; raw audio, checkpoints, and embeddings live on $SCRATCH
audio_cache/
checkpoints/
*.npz
*.pt
*.ckpt

# slurm
slurm-*.out
scripts/slurm/logs/

# X-ARES eval (Stage 1) — task defs symlink is machine-specific (points at
# $AUDIO_COMP_EXTERNAL), recreated by scripts/setup_xares.sh; env/ is
# X-ARES's own working dir (Zenodo downloads, encoded embeddings, MLP
# checkpoints) which lives on $SCRATCH via xares_env, never under the repo
xares_eval/tasks
env/
# xares's download_hf_model_to_local() downloads to CWD by default with no
# override — its Qwen2 dependency for the LibriSpeech-ASR task lands here
/Qwen/

# os/editor
.DS_Store
.ipynb_checkpoints/

# CONFIDENTIAL — real labelled vessel-acoustic data (AIS-derived), added
# 2026-08-11. Never commit, never push, never let this leave local disk.
# Streaming-only access to the underlying audio (see
# scripts/remote_stream.py); this directory holds only local label/index
# CSVs and must be deleted once the confidential-data experiment is done
# (per explicit user instruction — no exceptions, no "just this once").
data/AIS/
